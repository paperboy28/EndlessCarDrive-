<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#251F2B"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting for connection..."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/btnLeft"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:text="◀"
        android:textSize="50sp"
        android:textColor="#6E1A20"
        android:gravity="center"
        android:background="@drawable/bg_clay_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/btnRight"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:text="▶"
        android:textSize="50sp"
        android:textColor="#6E1A20"
        android:gravity="center"
        android:background="@drawable/bg_clay_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnLeft"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/btnAccel"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="▲"
        android:textSize="50sp"
        android:textColor="#6E1A20"
        android:gravity="center"
        android:background="@drawable/bg_clay_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/btnBrake"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:text="▼"
        android:textSize="50sp"
        android:textColor="#6E1A20"
        android:gravity="center"
        android:background="@drawable/bg_clay_button"
        app:layout_constraintBottom_toTopOf="@id/btnAccel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/btnNitro"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:text="⚡"
        android:textSize="40sp"
        android:textColor="#0E3F70"
        android:gravity="center"
        android:background="@drawable/bg_clay_button"
        app:layout_constraintBottom_toTopOf="@id/btnBrake"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/btnPause"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:text="⏸"
        android:textSize="30sp"
        android:textColor="#3D2F52"
        android:gravity="center"
        android:background="@drawable/bg_clay_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>